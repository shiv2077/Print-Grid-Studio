# PrintGrid Studio — monorepo env reference.
# Copy the relevant blocks into apps/api/.env (server secrets) and
# apps/web/.env.local (NEXT_PUBLIC_* only). Never commit real .env files.
# All real .env / .env.local files are gitignored. ALL money is integer paise.

# ───────────────────────────────────────────────────────────────────────────
# apps/api  (server-only secrets — NEVER expose to the browser, never commit)
# ───────────────────────────────────────────────────────────────────────────
# Postgres. For Supabase + serverless use the POOLER (port 6543) as DATABASE_URL
# and the direct (5432) string as DIRECT_URL for migrations. db.<ref>.supabase.co
# is IPv6-only — use the pooler from IPv4-only/serverless hosts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."     # service_role / secret key — Storage uploads
SUPABASE_STORAGE_BUCKET="order-files"          # PRIVATE bucket; reads via short-lived signed URLs

RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."                  # set after registering the webhook (M2.5)

RESEND_API_KEY="re_..."
RESEND_FROM="PrintGrid Studio <orders@printgrid.co.in>"

PORT="3001"
WEB_ORIGIN="http://localhost:3000"             # CORS allow-origin for the web app

# ───────────────────────────────────────────────────────────────────────────
# apps/web  (NEXT_PUBLIC_* are shipped to the browser — key_id only, NEVER secrets)
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
NEXT_PUBLIC_API_URL="http://localhost:3001"
