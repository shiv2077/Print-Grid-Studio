# PrintGrid Studio — env reference.
# The whole app is one Next.js app (apps/web) with same-origin /api route handlers.
# Put ALL of these in apps/web/.env.local for local dev, and in the Vercel
# dashboard for production. Real .env* files are gitignored. Money = integer paise.

# ─── Database (Postgres / Supabase) ────────────────────────────────────────────
# LOCAL dev: the direct host works.
#   postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require
# PRODUCTION (Vercel): you MUST use the POOLER (port 6543, Transaction mode) —
# Vercel is IPv4-only and the direct db.<ref>.supabase.co host is IPv6-only.
# Get it from Supabase → Settings → Database → Connection string → Transaction:
#   postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# (lib/server/db.ts already sets prepare:false, required for the pooler.)
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?sslmode=require"

# ─── Supabase (Storage for uploaded models) ────────────────────────────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."     # secret/service_role — private bucket uploads
SUPABASE_STORAGE_BUCKET="order-files"          # PRIVATE; reads via short-lived signed URLs

# ─── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."                  # set after registering the webhook on deploy

# ─── Resend (transactional email; no-ops without a key) ────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM="PrintGrid Studio <orders@printgrid.co.in>"

# ─── Browser-exposed (key_id is safe to expose; NEVER secrets) ─────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Optional: shared secret for the protected order status-update endpoint.
# If unset, POST /api/orders/[code]/status returns 503 (feature disabled).
ADMIN_STATUS_SECRET=""

# Public site URL (used for metadata/sitemap/JSON-LD). Defaults to https://printgrid.co.in
NEXT_PUBLIC_SITE_URL="https://printgrid.co.in"
