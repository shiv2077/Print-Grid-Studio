{
  "name": "printgrid-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "build:pricing": "pnpm --filter @printgrid/pricing build",
    "build:web": "pnpm --filter @printgrid/pricing build && pnpm --filter web build",
    "dev:web": "pnpm --filter web dev"
  }
}
