# apps/api/.env — SERVER-ONLY secrets. Copy to apps/api/.env (gitignored). Never commit.
# All money is integer paise. An order is marked paid ONLY by a signature-verified webhook.

# Postgres (Supabase). Use the POOLER (6543) for runtime; DIRECT_URL (5432) for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Storage (private `order-files` bucket). service_role/secret key required for uploads.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="order-files"

# Razorpay (TEST mode only in this build)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# Resend (confirmation email on `paid`)
RESEND_API_KEY="re_..."
RESEND_FROM="PrintGrid Studio <orders@printgrid.co.in>"

# Server
PORT="3001"
WEB_ORIGIN="http://localhost:3000"
