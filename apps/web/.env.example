# apps/web/.env.local — copy and fill. Gitignored. Razorpay TEST mode.
# Server-only (used by /api route handlers; on Vercel set these in the dashboard):
# IMPORTANT: on Vercel use the Supabase POOLER url (port 6543), not the direct host.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?sslmode=require"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="order-files"
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."
RESEND_API_KEY="re_..."
RESEND_FROM="PrintGrid Studio <orders@printgrid.co.in>"

# Browser-exposed:
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
